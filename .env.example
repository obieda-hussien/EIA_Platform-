MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/?retryWrites=true&w=majority
MONGODB_DB=eia_platform
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set only for setup. Remove after creating the first owner at /admin.
ADMIN_SETUP_TOKEN=
# Required to enable administrator TOTP. Generate once and keep it across deploys.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Production only: store as a sensitive Vercel environment variable.
MFA_ENCRYPTION_KEY=

# Administration is available ONLY on this exact HTTP Host (include port locally).
ADMIN_HOST=localhost:3000
PUBLIC_SITE_URL=https://eia-platform-chi.vercel.app
